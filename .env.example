# PostgreSQL (o app usa o banco `bomfim`; se a URL terminar em /postgres, será redirecionado automaticamente)
# No VPS: DB_HOST=127.0.0.1 (PostgreSQL no mesmo servidor)
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/bomfim
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=bomfim
# DB_USER=postgres
# DB_PASSWORD=SUA_SENHA
# DB_SSLMODE=prefer

FLASK_CONFIG=development
# Produção: FLASK_CONFIG=production  FLASK_DEBUG=0
# FLASK_DEBUG=0

SECRET_KEY=altere-em-producao
API_PORT=5001

# Origens do front (produção com domínio próprio)
# CORS_ORIGINS=https://app.seudominio.com.br

# Porta do Vite (opcional)
# PORT=5173

# ReceitaWS — consulta CNPJ (opcional; plano gratuito ~3 req/min, sem token)
# Token só se contratar plano pago em https://www.receitaws.com.br/
# RECEITAWS_TOKEN=

# Integrações — validação na barra "CONECTADO À OPERAÇÃO" (GET /api/integrations/access-status)
# Pipefy: PYPEFY_USUARIO + PYPEFY_SENHA (ou PIPEFY_*) = acesso configurado. Opcional: PIPEFY_API_TOKEN para testar a API.
# PYPEFY_USUARIO=
# PYPEFY_SENHA=
# PIPEFY_API_TOKEN=

# Moskit: MOSKIT_USUARIO + MOSKIT_SENHA = acesso configurado (barra verde). Opcional: MOSKIT_API_KEY para testar a API v2.
# MOSKIT_USUARIO=
# MOSKIT_SENHA=
# MOSKIT_API_KEY=
# Click Sign: Access Token da API v3 (Configurações → API)
# CLICKSIGN_ACCESS_TOKEN=
# CLICKSIGN_BASE_URL=https://app.clicksign.com
# Sandbox: CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
# Zapier: ZAPIER_USUARIO + ZAPIER_SENHA = acesso configurado (barra verde). Opcional: ZAPIER_API_KEY para testar a API.
# ZAPIER_USUARIO=
# ZAPIER_SENHA=
# ZAPIER_API_KEY=

# TypeSafe (CentralComm) — roteador Cursor (hooks; não usado pela API Flask)
# Copie de aicentralv2 ou rode: python scripts/sync_typesafe_router_key.py
# TYPESAFE_ROUTER_API_KEY=
