# Copie para deploy/deploy.env no servidor (não versionar secrets).
# source deploy/deploy.env é feito automaticamente por post-upload.sh

# Python do sistema usado para criar/atualizar .venv (python3, python3.11, …)
PYTHON_BIN=python3

# Pasta do venv: .venv (padrão) ou venv (Vultr /opt/bomfim)
# VENV_DIR=venv

# 1 = cria venv se não existir e atualiza pip (padrão)
ENSURE_VENV=1

# Git (deploy/deploy.sh)
GIT_REMOTE=origin
GIT_BRANCH=main

# systemd (API Flask via gunicorn)
BOMFIM_SERVICE=bomfim-api

# Recarregar Nginx após deploy (0 = não)
RELOAD_NGINX=1

# Rodar seed idempotente após migrate (1 só na primeira instalação)
RUN_SEED=0

# Pular build do front (1 = só API/deps/migrate)
SKIP_FRONTEND=0

# Porta usada no health check local
API_PORT=5001
